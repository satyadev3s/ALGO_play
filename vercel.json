{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["**/*.html", "**/*.css", "**/*.js", "**/*.json", "**/*.mp4", "**/*.jpg", "**/*.png", "**/*.svg"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/assignments(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/upload-assignment(.*)",
      "dest": "/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
